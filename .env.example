# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Required: Bedrock API key (short- or long-term), sent as a bearer token.
HARNESS_BEDROCK_API_KEY=

# Optional: Anthropic or DeepSeek Bedrock model id. Default: deepseek.v3.2
# e.g. us.anthropic.claude-sonnet-4-5-20250929-v1:0
HARNESS_BEDROCK_MODEL=deepseek.v3.2

# Optional: region of the bedrock-runtime endpoint. Default: $AWS_REGION, else us-east-1
HARNESS_BEDROCK_REGION=us-east-1
